# Supabase — copy this file to .env.local and fill in your project values.
# Find these in: Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-public-key>
VITE_VAPID_PUBLIC_KEY=<your VAPID public key from scripts/generate-vapid-keys.mjs>
# VAPID_PRIVATE_KEY and VAPID_SUBJECT → Supabase project secrets (not .env — see scripts/generate-vapid-keys.mjs)
